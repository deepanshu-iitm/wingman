{
  "name": "@wingman/orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=../.env --experimental-strip-types --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
