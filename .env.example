# Copy this file to .env and replace private values locally.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_INTERVIEW_MODEL=gpt-5.6-luna
SMALLEST_API_KEY=
RESEND_API_KEY=
WELCOME_EMAIL_FROM=Wingman <hello@your-domain.com>

ORCHESTRATOR_PORT=8787
CLIENT_ORIGIN=http://localhost:5173
VITE_ORCHESTRATOR_URL=http://localhost:8787
SPACETIMEDB_HOST=https://maincloud.spacetimedb.com
SPACETIMEDB_DATABASE=wingman

# ── Matching orchestrator (orchestrator/matching) ─────────────────────────────
# File where the matching worker persists its SpacetimeDB identity token so it
# keeps a stable identity across restarts. Never commit the real token file.
ORCHESTRATOR_TOKEN_FILE=.orchestrator-token
RETRY_SCAN_MS=3000
